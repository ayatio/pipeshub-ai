# ---------------------------------------------------------------------------
# Living Brain configuration. Copy to `.env` and adjust as needed:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# Where the SQLite database lives (created by `make db`).
LB_DB_PATH=./data/brain.db

# Ollama endpoint. Leave as-is for a standard local install.
LB_OLLAMA_URL=http://localhost:11434

# Models. These are the ones the setup pulls:
#     ollama pull nomic-embed-text
#     ollama pull qwen2.5:14b
LB_EMBED_MODEL=nomic-embed-text
LB_LLM_MODEL=qwen2.5:14b

# Embedding dimension for the configured embed model (nomic-embed-text = 768).
LB_EMBED_DIM=768

# If Ollama is unreachable, the brain still works using a deterministic local
# fallback embedder / summarizer so the pipeline never hard-fails.
LB_FALLBACK_EMBED_DIM=256

# Retrieval / consolidation knobs.
LB_TOP_K=5

# Similarity thresholds for the real embedding model (nomic-embed-text).
LB_CLUSTER_THRESHOLD=0.72
LB_DUPLICATE_THRESHOLD=0.95

# The local fallback embedder lives in a sparser space, so it uses its own
# (lower) thresholds. These are only used when Ollama is unreachable.
LB_FALLBACK_CLUSTER_THRESHOLD=0.24
LB_FALLBACK_DUPLICATE_THRESHOLD=0.85

LB_DECAY_HALF_LIFE_DAYS=14
LB_IMPORTANCE_FLOOR=0.05

LB_LOG_LEVEL=INFO
