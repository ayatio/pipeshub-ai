# --- Database (Postgres 16/17 + pgvector + pg_trgm) ---
# Docker compose publishes Postgres on host port 5433 (avoids clashing with a
# local 5432). Change the port here and in docker-compose.yml together.
DATABASE_URL=postgresql://brain:brain@localhost:5433/brain

# --- Vault (markdown = source of truth) ---
VAULT_PATH=./vault

# --- Ollama (local embeddings + extraction) ---
OLLAMA_URL=http://localhost:11434
MODEL_EMBED=nomic-embed-text
MODEL_EXTRACT=qwen2.5:14b
EMBED_DIM=768

# Optional cloud fallback for the EXTRACTION step only, used when local JSON
# failure rate is too high. Leave empty to stay fully local.
# Format: "openai:gpt-4o-mini" or "anthropic:claude-sonnet-5". Requires the
# matching *_API_KEY below.
EXTRACT_FALLBACK=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- MCP server ---
MCP_PORT=8848
MCP_TOKEN=change-me
