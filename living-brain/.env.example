# ---------------------------------------------------------------------------
# living-brain configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Database. Default is a zero-dependency local SQLite file.
# For the production Postgres + pgvector backend (see docker-compose.yml), use:
#   DATABASE_URL=postgresql://brain:brain@localhost:5433/living_brain
DATABASE_URL=sqlite:///./data/living_brain.db

# Ollama endpoint + models. If Ollama is unreachable, living-brain falls back
# to deterministic local embeddings and a template summarizer so every command
# still runs (with lower quality). Pull the models with:
#   ollama pull nomic-embed-text
#   ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:14b

# Embedding dimensionality. nomic-embed-text = 768. Keep the fallback in sync.
EMBED_DIM=768

# Consolidation tuning.
# How many nearest neighbours to link each memory to during a night run.
LINK_TOP_K=5
# Minimum cosine similarity for an associative link to be created.
LINK_MIN_SIM=0.35
# Importance decay applied to un-accessed memories each night (0-1, per run).
IMPORTANCE_DECAY=0.98
# Minimum cluster size before the brain writes a "theme" insight.
THEME_MIN_CLUSTER=3

# Where `brain ingest` looks for notes by default.
NOTES_DIR=./data/notes
