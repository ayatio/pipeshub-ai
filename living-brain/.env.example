# --- Living Brain configuration ---------------------------------------------

# Database. Default is a zero-infra SQLite file so the project runs anywhere.
# For Postgres:  DATABASE_URL=postgresql://user:pass@localhost:5432/brain
#   (requires:  uv sync --extra postgres)
DATABASE_URL=sqlite:///./data/brain.db

# Ollama endpoint + models. If Ollama is unreachable the engine transparently
# falls back to a deterministic offline embedding and an extractive reflector,
# so the full pipeline still completes (in DEGRADED mode).
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=qwen2.5:14b
EMBED_DIM=768

# Nightly consolidation defaults
NIGHT_DEFAULT_MINUTES=60
NIGHT_BATCH_SIZE=5
# Stop a night run early once there is nothing left to consolidate (converged).
NIGHT_STOP_WHEN_IDLE=1
