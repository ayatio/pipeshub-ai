# ---------------------------------------------------------------------------
# living-brain configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env
# Every value below has a sensible default, so an empty .env still works.
# ---------------------------------------------------------------------------

# Where the SQLite database lives (relative paths are resolved from project root).
LB_DB_PATH=data/brain.db

# Directory that holds your notes (markdown / plain text). Ingest walks it.
LB_NOTES_DIR=data/notes

# Where nightly consolidation reports are written.
LB_REPORTS_DIR=data/reports

# --- Ollama (optional) -----------------------------------------------------
# If an Ollama server is reachable at LB_OLLAMA_URL, living-brain uses these
# models for embeddings and summarization. If it is NOT reachable, it silently
# falls back to a built-in deterministic embedder + extractive summarizer, so
# everything still runs offline.
LB_OLLAMA_URL=http://localhost:11434
LB_EMBED_MODEL=nomic-embed-text
LB_LLM_MODEL=qwen2.5:14b

# Embedding dimension used by the offline fallback embedder.
LB_EMBED_DIM=256

# Chunking: target characters per chunk and overlap between chunks.
LB_CHUNK_SIZE=800
LB_CHUNK_OVERLAP=120

# Request timeout (seconds) when talking to Ollama before falling back.
LB_OLLAMA_TIMEOUT=5
